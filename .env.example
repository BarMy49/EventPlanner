# Required for automatic Let's Encrypt certificate issuance.
DOMAIN=your-domain.example
LETSENCRYPT_EMAIL=you@example.com

# Backend origin policy. Replace the domain with the value above.
CORS_ORIGINS=https://your-domain.example

# Required application secrets and administrator account.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Google Calendar OAuth. Register the redirect URI in Google Cloud exactly as shown.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/api/integrations/google-calendar/callback
APP_PUBLIC_URL=https://your-domain.example
# A URL-safe base64 Fernet key. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
EVENT_TIME_ZONE=Europe/Warsaw
